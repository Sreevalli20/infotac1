@'
# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# Build artifacts
build/
dist/
*.egg-info/
*.so
*.pyd

# Logs and generated data
logs/
*.log
benchmark-results/
bench/results/
*.prof
*.tmp

# Secrets
.env
.env.*
!.env.example
!.env.template
*.pem
*.key

# Editors and operating system
.vscode/
.idea/
.DS_Store
Thumbs.db
'@ | Set-Content -LiteralPath .gitignore -Encoding utf8